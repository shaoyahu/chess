{
  "name": "lan-chess",
  "version": "1.0.0",
  "private": true,
  "description": "局域网多人国际象棋：实时对战 + 观战 + 2D/3D 双视角",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "next build",
    "start": "NODE_ENV=production tsx server.ts",
    "start:ws": "NODE_ENV=production tsx server-ws.ts",
    "lan": "tsx scripts/print-lan.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "licenses": "tsx scripts/check-licenses.ts",
    "contrast": "tsx scripts/check-contrast.ts",
    "deploy:check": "tsx scripts/check-deploy.ts",
    "assets:pieces": "tsx --tsconfig tsconfig.scripts.json scripts/generate-pieces.ts",
    "gen:endgame-puzzles": "tsx scripts/generate-endgame-puzzles.ts",
    "audit:endgame-puzzles": "tsx scripts/audit-endgame-puzzles.ts",
    "preview:appearance": "tsx --tsconfig tsconfig.scripts.json scripts/preview-piece-appearance.ts",
    "assets:silhouette": "tsx scripts/dump-piece-silhouette.ts artifacts/silhouette 0 game",
    "verify": "npm run typecheck && npm run test && npm run licenses && npm run contrast && npm run verify:ws-only && npm run verify:engine && npm run verify:stockfish",
    "verify:lan": "tsx scripts/verify-lan.ts",
    "verify:3d": "tsx scripts/verify-3d-viewport.ts",
    "verify:arrow": "tsx scripts/verify-move-arrow.ts",
    "verify:ui": "tsx scripts/verify-settings-ui.ts",
    "verify:ui-style": "tsx scripts/verify-ui-style.ts",
    "verify:room-exit": "tsx scripts/verify-room-exit.ts",
    "verify:timeout": "tsx scripts/verify-timeout.ts",
    "verify:reconnect": "tsx scripts/verify-reconnect.ts",
    "verify:dm": "tsx scripts/verify-dm.ts",
    "verify:invite": "tsx scripts/verify-invite.ts",
    "verify:drag": "tsx scripts/verify-drag.ts",
    "verify:replay": "tsx scripts/verify-replay.ts",
    "verify:practice": "tsx scripts/verify-practice.ts",
    "verify:endgame-puzzles": "tsx scripts/verify-endgame-puzzles.ts",
    "verify:connection-state": "tsx scripts/verify-connection-state.ts",
    "verify:lessons": "tsx scripts/verify-lesson-text.ts",
    "verify:color-draw": "tsx scripts/verify-color-draw.ts",
    "verify:ws-only": "tsx scripts/verify-ws-only.ts",
    "verify:engine": "tsx scripts/verify-engine-tactics.ts",
    "verify:stockfish": "tsx scripts/verify-stockfish.ts",
    "solve:3d": "tsx scripts/solve-3d-camera.ts",
    "mutate:3d": "tsx scripts/mutate-frame3d.ts",
    "mutate:contrast": "tsx scripts/mutate-contrast.ts",
    "mutate:arrow": "tsx scripts/mutate-move-arrow.ts",
    "mutate:ui": "tsx scripts/mutate-settings-ui.ts",
    "mutate:pixel": "tsx --tsconfig tsconfig.scripts.json scripts/mutate-pixel-silhouette.ts",
    "mutate:ui-style": "tsx scripts/mutate-ui-style.ts",
    "mutate:room-exit": "tsx scripts/mutate-room-exit.ts",
    "mutate:reconnect": "tsx scripts/mutate-reconnect.ts",
    "mutate:dm": "tsx scripts/mutate-dm.ts",
    "mutate:invite": "tsx scripts/mutate-invite.ts",
    "mutate:drag": "tsx scripts/mutate-drag.ts",
    "mutate:replay": "tsx scripts/mutate-replay.ts",
    "mutate:lessons": "tsx scripts/mutate-lesson-text.ts",
    "mutate:practice": "tsx scripts/mutate-practice.ts",
    "mutate:endgame-puzzles": "tsx scripts/mutate-endgame-puzzles.ts",
    "mutate:connection-state": "tsx scripts/mutate-connection-state.ts",
    "mutate:color-draw": "tsx scripts/mutate-color-draw.ts",
    "mutate:engine": "tsx scripts/mutate-engine-tactics.ts",
    "mutate:stockfish": "tsx scripts/mutate-stockfish.ts"
  },
  "dependencies": {
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "chess.js": "^1.4.0",
    "lucide-react": "^1.71.0",
    "next": "^14.2.33",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "stockfish": "^19.0.1",
    "three": "^0.171.0",
    "tsx": "^4.19.2",
    "ws": "^8.18.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/three": "^0.171.0",
    "@types/ws": "^8.5.13",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  },
  "license": "GPL-3.0",
  "engines": {
    "node": "22.x"
  }
}
