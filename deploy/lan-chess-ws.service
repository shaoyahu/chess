# 局域网国际象棋 —— **只跑 WebSocket** 的 systemd 服务单元
#
# 装到：/etc/systemd/system/lan-chess-ws.service
# 启用：systemctl daemon-reload && systemctl enable --now lan-chess-ws
# 看日志：journalctl -u lan-chess-ws -f
#
# 用途：**混合部署**（页面在 Vercel、实时服务在这台机器上）。
# 与 `lan-chess.service` 的区别是**不跑 Next.js** —— 见下面「为什么单独一个单元」。
#
# 为什么单独一个单元（而不是在 lan-chess.service 里加开关）：
#  ① **服务器上不用构建 Next.js**。`next build` 的内存峰值能把一台总内存
#     1586MB 的机器打到**整机僵死**（而且一旦僵死连不上 SSH，只能从云控制台
#     重启 —— agent 做不到这件事）。只要 WS 就不需要 `.next` 产物，
#     于是这台机器上**整个构建步骤可以跳过**。
#     共享生产机上尤其重要：构建会把上面那些线上服务一起拖下水。
#  ② 常驻内存更小：不加载 Next 的运行时。
#  ③ 页面在 Vercel，这台机器暴露到公网的只有 nginx 的 443（带 TLS），
#     应用本身只监听回环地址。

[Unit]
Description=局域网国际象棋 · WebSocket 服务（混合部署：页面在 Vercel）
After=network-online.target
Wants=network-online.target

[Service]
Type=simple

# 改这里：不要用 root。
# 房间状态要往 .data 目录落盘，root 跑出来的文件属主是 root，
# 以后换成普通用户就写不进去了（部署自检第 4 项会报这个）。
User=lan-chess
Group=lan-chess

# 改这里：项目目录（要能用服务用户读，.data 要能写）
WorkingDirectory=/opt/lan-chess

Environment=NODE_ENV=production

# 只监听回环地址 —— 公网暴露的是 nginx 的 443，不是这个端口。
# 真要直接对外（临时调试）才改成 0.0.0.0。
Environment=HOST=127.0.0.1
Environment=PORT=3000

# 存档目录。默认是 <项目目录>/.data，单独指出来更清楚，
# 也方便跟「整站部署」那套并存（两个单元各写各的存档）。
Environment=LAN_CHESS_DATA_DIR=/opt/lan-chess/.data

# 引擎路径。**装了原生 Stockfish 就写这儿** —— 原生版比 npm 的 WASM 版
# 省内存得多（实测 WASM 版光哈希就吃 472MB，原生版哈希 64MB 时整个引擎
# anon 才 117MB）。
# 不写就自动用 npm 的 WASM 版（跨平台都能跑，但内存代价大）。
Environment=STOCKFISH_PATH=/usr/local/bin/stockfish

# 引擎哈希表大小（MB）。**内存紧张的小机器要调小**：
# 实测 64MB → 16MB，引擎的 anon 占用从 117MB 降到 74.5MB（省 42.6MB）。
# 本机开发不用设，走默认的 64MB。
Environment=STOCKFISH_HASH_MB=16

# 引擎线程数。这台机器只有 **2 核**，还跑着另外 4 个线上站点 ——
# 引擎不该把两个核都占了。实测改成 1 线程后**AI 落子没变慢**
#（难度是 Elo + 深度上限封顶的，不是时间封顶），但能给同机别的服务让出一个核。
Environment=STOCKFISH_THREADS=1

# 改这里：node 的绝对路径（which node 查）。
#
# ⚠️ **不要用 tsx 跑这个入口** —— tsx 每次要拉起一整套运行时
# （一个 tsx 的 node 运行时 + 一个常驻的 esbuild 服务，约 66MB RSS），
# 而服务端还会 spawn 一个独立的引擎 worker 子进程，**那个也是用 tsx 起的**，
# 于是开一局 AI 对局时 cgroup 里是 **7 个进程**（去掉 tsx 后降到 **3 个**，
# 峰值 351MB → 333MB）。
#
# 现在用的是 node 自带的 TypeScript 支持（22.18+ 默认开启类型剥离，
# `--experimental-transform-types` 连 enum、参数属性也支持），
# `scripts/ts-loader.mjs` 负责补文件扩展名和 tsconfig 的 `@/` 别名。
# **跑的还是仓库里那份源码**，不是打包产物 —— 没有构建漂移的问题。
#
# node 版本要求：**22.18+**（更老的没有类型剥离）。
ExecStart=/usr/bin/node --experimental-transform-types --import file:///opt/lan-chess/scripts/ts-loader.mjs /opt/lan-chess/server-ws.ts

Restart=always
RestartSec=3

# 崩溃时留日志，别静默重启
StandardOutput=journal
StandardError=journal

# ---- 内存上限（2026-11-28 实测重算，不是拍脑袋）----
#
# 为什么要设：这台机器还跑着另外 4 个线上站点，
# 我们这个服务要是无节制地吃内存，被挤爆的是**别人的服务**。
#
# 2026-11-27 的 700M 是**按 WASM 版引擎**定的：
#   空闲 67MB / 开一局 AI 对局 594MB（WASM 版引擎一个就占 472MB）
#   → 256M 会把每一局 AI 对局都打死，所以定 700M。
#
# 2026-11-28 换成**原生 Stockfish 19** + 哈希 16MB + 去掉 tsx 后重新实测：
#   空闲（还没开过 AI 局）：106MB（anon 73MB），cgroup 里 **1 个进程**
#   开一局 AI 对局（峰值）：**333MB**（anon 213MB + file 120MB），**3 个进程**
#     ① 主服务 node   ② 引擎 worker node   ③ stockfish
#   内存上限实测：256M ✗ / 272M ✗ / 288M ✗ / 320M ✗ / **384M ✓**（余量 51MB）
#
# ⚠️ **为什么 256M 够不着**（不是参数问题）：
#   引擎**搜索时**的 anon 峰值就有 ~213~253MB（跟哈希表大小、线程数都无关 ——
#   实测 Hash 16/4MB、2 线程/1 线程，峰值都在 250MB 上下）。
#   加上内核开销（页表、slab 等约 8MB）就已经 260MB 上下，
#   256M 的上限**连 file 缓存一点都不留也装不下** —— 数学上就不可能。
#
#   去掉 tsx 确实有用（进程 7 → 3，峰值 351MB → 333MB），
#   但**压不到 256M** —— 真正的大头是引擎搜索本身的内存。
#   要再往下压，得动引擎本身（比如把引擎并进主进程，省掉 worker 那份 node 运行时），
#   那是架构改动，得单独排一轮。
#
# ⚠️ 代价：内存吃紧时引擎的 NNUE 页会被回收再读盘，AI 落子会变慢。
#    要更快就把 STOCKFISH_HASH_MB 调大、MemoryMax 调高。
MemoryMax=384M

# 基本加固：不让提权，/tmp 私有
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
