# 局域网国际象棋 —— **只跑 WebSocket** 的 systemd 服务单元
#
# 装到：/etc/systemd/system/lan-chess-ws.service
# 启用：systemctl daemon-reload && systemctl enable --now lan-chess-ws
# 看日志：journalctl -u lan-chess-ws -f
#
# 用途：**混合部署**（页面在 Vercel、实时服务在这台机器上）。
# 与 `lan-chess.service` 的区别是**不跑 Next.js** —— 见下面「为什么单独一个单元」。
#
# 为什么单独一个单元（而不是在 lan-chess.service 里加开关）：
#  ① **服务器上不用构建 Next.js**。`next build` 的内存峰值能把一台总内存
#     1586MB 的机器打到**整机僵死**（而且一旦僵死连不上 SSH，只能从云控制台
#     重启 —— agent 做不到这件事）。只要 WS 就不需要 `.next` 产物，
#     于是这台机器上**整个构建步骤可以跳过**。
#     共享生产机上尤其重要：构建会把上面那些线上服务一起拖下水。
#  ② 常驻内存更小：不加载 Next 的运行时。
#  ③ 页面在 Vercel，这台机器暴露到公网的只有 nginx 的 443（带 TLS），
#     应用本身只监听回环地址。

[Unit]
Description=局域网国际象棋 · WebSocket 服务（混合部署：页面在 Vercel）
After=network-online.target
Wants=network-online.target

[Service]
Type=simple

# 改这里：不要用 root。
# 房间状态要往 .data 目录落盘，root 跑出来的文件属主是 root，
# 以后换成普通用户就写不进去了（部署自检第 4 项会报这个）。
User=lan-chess
Group=lan-chess

# 改这里：项目目录（要能用服务用户读，.data 要能写）
WorkingDirectory=/opt/lan-chess

Environment=NODE_ENV=production

# 只监听回环地址 —— 公网暴露的是 nginx 的 443，不是这个端口。
# 真要直接对外（临时调试）才改成 0.0.0.0。
Environment=HOST=127.0.0.1
Environment=PORT=3000

# 存档目录。默认是 <项目目录>/.data，单独指出来更清楚，
# 也方便跟「整站部署」那套并存（两个单元各写各的存档）。
Environment=LAN_CHESS_DATA_DIR=/opt/lan-chess/.data

# 引擎路径。**装了原生 Stockfish 就写这儿** —— 原生版比 npm 的 WASM 版
# 省内存得多（实测 WASM 版光哈希就吃 472MB，原生版哈希 64MB 时整个引擎
# anon 才 117MB）。
# 不写就自动用 npm 的 WASM 版（跨平台都能跑，但内存代价大）。
Environment=STOCKFISH_PATH=/usr/local/bin/stockfish

# 引擎哈希表大小（MB）。**内存紧张的小机器要调小**：
# 实测 64MB → 16MB，引擎的 anon 占用从 117MB 降到 74.5MB（省 42.6MB）。
# 本机开发不用设，走默认的 64MB。
Environment=STOCKFISH_HASH_MB=16

# 改这里：node 的绝对路径（which node 查）。
# 直接用 tsx 的 CLI，避免多一层 npm 包装（npm start 会再套一层 sh）。
ExecStart=/usr/bin/node /opt/lan-chess/node_modules/tsx/dist/cli.mjs server-ws.ts

Restart=always
RestartSec=3

# 崩溃时留日志，别静默重启
StandardOutput=journal
StandardError=journal

# ---- 内存上限（2026-11-28 实测重算，不是拍脑袋）----
#
# 为什么要设：这台机器还跑着另外 4 个线上站点，
# 我们这个服务要是无节制地吃内存，被挤爆的是**别人的服务**。
#
# 2026-11-27 的 700M 是**按 WASM 版引擎**定的：
#   空闲 67MB / 开一局 AI 对局 594MB（WASM 版引擎一个就占 472MB）
#   → 256M 会把每一局 AI 对局都打死，所以定 700M。
#
# 2026-11-28 换成**原生 Stockfish 19** 后重新实测（这台机器）：
#   引擎 anon：117MB（哈希 64MB）→ 74.5MB（哈希 16MB）
#   引擎 file：~98MB（103MB 二进制里 NNUE 那些页，**内核可回收**）
#   服务 cgroup 峰值：anon ~187MB / file ~242MB / 合计 ~480MB
#
# 定 256M 的依据：anon ~187MB + 内核开销 ~8MB = ~195MB，
# 剩下 ~60MB 给 file 缓存 —— 内核会优先回收 file 缓存
# （引擎二进制页、node_modules 页缓存都能丢，丢了只是变慢，不会出错）。
# 这就是「256M 压得回去」的全部依据，**不是拍脑袋**。
#
# ⚠️ 代价：内存吃紧时引擎的 NNUE 页会被回收再读盘，
#    AI 落子会变慢。要更快就把 STOCKFISH_HASH_MB 调大、MemoryMax 调高。
MemoryMax=256M

# 基本加固：不让提权，/tmp 私有
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
